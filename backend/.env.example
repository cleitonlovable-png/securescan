# Copie este arquivo para .env e ajuste os valores antes de rodar em produção.
# NUNCA commite o arquivo .env de verdade.

DATABASE_URL=postgresql+psycopg://securescan:securescan@postgres:5432/securescan
REDIS_URL=redis://redis:6379/0

JWT_SECRET=troque-por-uma-chave-aleatoria-longa-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3001"]

DEFAULT_RATE_LIMIT_RPS=10
DEFAULT_TIMEOUT_SECONDS=8
MAX_CONCURRENT_SCANS_PER_ORG=3

ENVIRONMENT=development
